{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": {
    "name": "SHASEKI",
    "meaning": "Piedra Oblicua",
    "target": "shaseki.pro"
  },
  "color": {
    "bgPrimary": "#000000",
    "bgSurface": "#0B0B0B",
    "fgPrimary": "#DCDAD0",
    "fgMuted": "#737373",
    "borderSubtle": "#222222",
    "borderStrong": "#DCDAD0"
  },
  "typography": {
    "fontDisplay": "'Unbounded', sans-serif",
    "fontMono": "'JetBrains Mono', monospace",
    "fontBody": "'Space Grotesk', system-ui, -apple-system, sans-serif",
    "weights": {
      "display": [700, 800],
      "mono": [400, 500],
      "body": [400, 500]
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.5rem",
      "xl": "clamp(2rem, 5vw, 4rem)",
      "hero": "clamp(3rem, 9vw, 7.5rem)"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "1rem",
    "4": "1.5rem",
    "5": "2rem",
    "6": "3rem",
    "8": "4rem",
    "12": "6rem",
    "16": "8rem"
  },
  "geometry": {
    "radius": "0px",
    "chamferAngleDeg": 45,
    "chamferSm": "8px",
    "chamferMd": "16px",
    "containerMax": "1440px"
  },
  "motion": {
    "easeSharp": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationInstant": "100ms",
    "durationFast": "200ms",
    "durationBase": "350ms"
  },
  "layout": {
    "waybarHeight": "38px",
    "tmuxHeight": "38px",
    "tileGap": "8px",
    "desktopWorkspaceWidth": "92vw",
    "desktopPeekWidth": "8vw",
    "grainOpacity": 0.04
  }
}
